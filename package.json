{
  "name": "online-bookstore-2024012",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "test": "npm run test:unit && npm run test:ui",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "db:migrate:local": "wrangler d1 migrations apply bookstore-db-3 --local",
    "db:seed:local": "wrangler d1 execute bookstore-db-3 --local --file=./sql/seed.sql",
    "build": "esbuild client/main.tsx --bundle --jsx=automatic --outfile=public/assets/app.js",
    "generate-types": "wrangler types",
    "test:unit": "vitest run --config vitest.config.ts",
    "test:ui": "vitest run --config vitest.ui.config.ts"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.8.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.28.2",
    "jsdom": "^26.1.0",
    "miniflare": "5.20261118.0-beta",
    "typescript": "^5.9.3",
    "vitest": "^5.1.1",
    "wrangler": "^4.165.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20261118.1": true
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  }
}
